APP_NAME="Server Manager"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supported: mysql, pgsql. Create the database before running migrations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=server_manager
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# SPA / CORS / Sanctum
# ---------------------------------------------------------------------------
# Origin of the React application. Used for CORS and password reset links.
FRONTEND_URL=http://localhost:5173
# Comma separated hosts allowed to authenticate with a stateful session cookie.
# MUST include the SPA host:port, or every authenticated request will 401.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000
# Parent domain shared by the API and the SPA (no scheme, no port).
# In production with api.example.com + app.example.com use ".example.com".
SESSION_DOMAIN=localhost
# Extra CORS origins beyond FRONTEND_URL, comma separated.
CORS_ALLOWED_ORIGINS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
# MUST be true in production (HTTPS only).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use redis in production for real queue throughput.
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — required for password reset + expiry digests
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@server-manager.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Application specific
# ---------------------------------------------------------------------------
# Personal access token lifetime in minutes (blank = never expires).
SANCTUM_TOKEN_EXPIRATION=
# Lifetime granted when "remember me" is checked, in minutes (30 days).
SANCTUM_REMEMBER_TOKEN_EXPIRATION=43200
# Look-ahead window for the dashboard "expiring soon" cards.
EXPIRY_NOTIFICATION_WINDOW_DAYS=30
# Address that receives the daily expiry digest.
EXPIRY_NOTIFICATION_DIGEST_RECIPIENT=
# Throttling: requests per minute.
AUTH_RATE_LIMIT=5
API_RATE_LIMIT=120

# ---------------------------------------------------------------------------
# Database backups (php artisan db:backup)
# ---------------------------------------------------------------------------
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14
