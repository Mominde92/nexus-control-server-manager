# Build context exclusions.
#
# node_modules is excluded so `npm ci` resolves Linux-native binaries inside the
# image rather than copying Windows ones from the host.

.git
.gitignore

node_modules/
dist/
dist-ssr/

# Vite inlines VITE_* at build time via build args, so local env files must not
# leak into the image.
.env
.env.*
!.env.example

Dockerfile
.dockerignore
README.md

.idea/
.vscode/
*.local
*.log
npm-debug.log*
.oxlintcache
Thumbs.db
Desktop.ini
